NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/kao
REDIS_URL=redis://127.0.0.1:6379
# Prefix for every Redis key (rate limits, waiting room, all BullMQ queues), so environments can share one Redis: give each its own
REDIS_KEY_PREFIX=kao:

# openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# openssl rand -base64 32
PII_ENCRYPTION_KEY=
# openssl rand -hex 32
PII_HASH_KEY=

RUNNER_FEE_BPS=200
PUBLIC_WEB_URL=http://localhost:3000

# Printed on receipts the platform issues for organisers without a legal name and tax ID.
# Without a tax ID they are plain receipts; set PLATFORM_VAT_REGISTERED=true only with one.
PLATFORM_LEGAL_NAME=ก้าว (Kao)
PLATFORM_TAX_ID=
PLATFORM_BRANCH=00000
PLATFORM_ADDRESS=
PLATFORM_VAT_REGISTERED=false

# fake = local development gateway, omise = real Omise (test or live keys)
PAYMENT_GATEWAY=fake
FAKE_GATEWAY_SECRET=fake-gateway-dev-secret
OMISE_PUBLIC_KEY=
OMISE_SECRET_KEY=

# Files: private KYC documents (served only through authenticated API routes) and public event images
# (served at /v1/media/*). local = files under STORAGE_LOCAL_DIR; the seed writes its sample images there too.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=storage

# Enables /v1/dev/* (dev login, simulated payments). Refused when NODE_ENV=production.
ENABLE_DEV_ENDPOINTS=true

# Rate limits (Redis-backed, shared by all instances). Override defaults with e.g. RATE_LIMITS=checkout.user=10/60,public.ip=1200/60
RATE_LIMIT_ENABLED=true
RATE_LIMITS=
# Same value as the web's WEB_PROXY_SECRET: lets the web pass the visitor's IP (x-kao-client-ip) for per-IP limits
WEB_PROXY_SECRET=
# Waiting room: how long an admitted runner has to start checkout, and how often the next batch is let in
WAITING_ROOM_TOKEN_MINUTES=10
WAITING_ROOM_TICK_SECONDS=5
# Data retention (PDPA), a nightly job (Asia/Bangkok). Days after the event's last day before runners' ID numbers,
# contact details, emergency contacts and answers are erased (names, bibs and results stay); days after an unpaid
# order lapsed; days after an account was closed; days a rejected KYC document or a stalled team sign-up is kept.
# Admins see what is due at GET /v1/admin/retention. Keep the privacy policy on the web in step with these.
RETENTION_REGISTRATION_DAYS=365
RETENTION_UNPAID_DAYS=30
RETENTION_CLOSED_ACCOUNT_DAYS=30
RETENTION_KYC_DAYS=180
RETENTION_BATCH_SIZE=500
RETENTION_SCHEDULE=30 3 * * *
