NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/kao
REDIS_URL=redis://127.0.0.1:6379
# Prefix for the rate limit and waiting room keys (BullMQ uses its own), to share one Redis between environments
REDIS_KEY_PREFIX=kao:

# openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# openssl rand -base64 32
PII_ENCRYPTION_KEY=
# openssl rand -hex 32
PII_HASH_KEY=

RUNNER_FEE_BPS=200
PUBLIC_WEB_URL=http://localhost:3000

# fake = local development gateway, omise = real Omise (test or live keys)
PAYMENT_GATEWAY=fake
FAKE_GATEWAY_SECRET=fake-gateway-dev-secret
OMISE_PUBLIC_KEY=
OMISE_SECRET_KEY=

# Private files (KYC documents). local = files under STORAGE_LOCAL_DIR, served only through authenticated API routes
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=storage

# Enables /v1/dev/* (dev login, simulated payments). Refused when NODE_ENV=production.
ENABLE_DEV_ENDPOINTS=true

# Rate limits (Redis-backed, shared by all instances). Override defaults with e.g. RATE_LIMITS=checkout.user=10/60,public.ip=1200/60
RATE_LIMIT_ENABLED=true
RATE_LIMITS=
# Same value as the web's WEB_PROXY_SECRET: lets the web pass the visitor's IP (x-kao-client-ip) for per-IP limits
WEB_PROXY_SECRET=
# Waiting room: how long an admitted runner has to start checkout, and how often the next batch is let in
WAITING_ROOM_TOKEN_MINUTES=10
WAITING_ROOM_TICK_SECONDS=5
