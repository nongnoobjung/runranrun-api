{
  "name": "@kao/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node --watch -r @swc-node/register src/main.ts",
    "start": "node dist/src/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "jest --runInBand",
    "db:migrate": "node -r @swc-node/register db/migrate.ts",
    "db:seed": "node -r @swc-node/register db/seed.ts"
  },
  "dependencies": {
    "@fastify/multipart": "^9.4.0",
    "@nestjs/common": "^11.2.7",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.7",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-fastify": "^11.2.7",
    "bullmq": "^6.3.19",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.11.3",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.34.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.18",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "jest": "^29.7.0",
    "typescript": "~5.8.3"
  }
}
